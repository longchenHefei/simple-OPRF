    //unsigned char S_pack[ PACKBYTES ];

    //Rs_pack, 1st round, Receiver to Sender, B in Simplest, pks for Kyber, 1 OT each group, 2 messages (Public Keys) each OT.
    //unsigned char Rs_pack[ 2 ][ 4 * PACKBYTES ];
    unsigned char Rs_pack[ 2 ][ 2 * PKlength ];

    //Sr_pack, 2nd round, Sender to Receiver, ctxt.sm for Kyber, 1 OT each group, 2 messages (Ciphertexts) each OT.
    unsigned char Sr_pack[ 2 ][ nOT ][ 2 * CTlength ];

    //output seed from exec_base, then will expand the seed to outputs with PRGs.
    //We replace 4OTs each group with 1 OT each group, and message length in Kyber (= OTlength = 32 bytes = HASHBYTES) 
    //Maybe we can use 16 bytes message? no need. we only use the first 16 bytes.
