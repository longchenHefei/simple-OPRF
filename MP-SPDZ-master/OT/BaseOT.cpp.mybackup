//    unsigned char receiver_keys[ 2 ][ HASHBYTES ];

    //cs[4], get from receiver_inputs[i + j], 4 OTs each group. 
    //Now 2 OTs each group in Kyber 
    unsigned char cs;

    //variable in Kyber
    KyberOTCtxt ctxt;
    KyberOTPtxt ptxt;
    KyberOTRecver recver;
    KyberOtRecvPKs pks;
    KyberOtRecvPKs pks2;
    KyberOTCtxt ctxt2;

    printf("baseOT begin \n");
    if (ot_role & RECEIVER)
        {
            printf("Hi. I am a RECEIVER.\n");
        }

    if (ot_role & SENDER)
        {
            printf("Hi. I am a SENDER.\n");
        }
    //test KyberOT
    /*
    //random choice bit, unsigned char b
    randombytes(&recver.b, 1);
    recver.b &= 1;

    //sample random OT strings
    //sample message unsigned char [OTlength] m_0, m_1, OTlength=32
    randombytes(ptxt.sot[0], OTlength);
    randombytes(ptxt.sot[1], OTlength);

    //get receivers message and secret coins, pks <- R_OT(recver.b)
    KyberReceiverMessage(&recver, &pks);

    //get senders message, secret coins and ot strings, (ctxt.sm[0],[1]) <- S_OT(ptxt.sot[0], [1], [pks])
    KyberSenderMessage(&ctxt, &ptxt, &pks);

    //get receivers ot strings, recver.rot <- E_OT(ctxt.sm[b])
    KyberReceiverStrings(&recver, &ctxt);

    //convert output into something readable
    for (int i = 0; i < OTlength; i++)
        printf("%x", ptxt.sot[0][i]);
    printf(" ");
    for (int i = 0; i < OTlength; i++)
        printf("%x", ptxt.sot[1][i]);
    printf("\n\n");

    //receiver's output
    for (int i = 0; i < OTlength; i++) {
        printf("%x", recver.rot[i]);
    }
    printf("\n");

    //check correctness
    printf("Choice Bit: %i\n" , recver.b);
    if (memcmp(recver.rot, ptxt.sot[recver.b], OTlength) == 0)
    {
        printf("PASSED\n");
    }
    else
    {
        printf("FAILED\n");
    }
    */

    //original BaseOT, os[0] <- S_pack, Sender send S_pack to receiver. no need for Kyber OT.
 //   if (ot_role & SENDER)
 //   {
 //      sender_genS(&sender, S_pack);
 //       os[0].store_bytes(S_pack, sizeof(S_pack));
 //   }
    //sender send os[0], receiver receive os[1]
 //   send_if_ot_sender(P, os, ot_role);
 //   if (ot_role & RECEIVER)
 //   {
 //       os[1].get_bytes((octet*) receiver.S_pack, len);
 //       if (len != HASHBYTES)
 //       {
 //           cerr << "Received invalid length in base OT\n";
 //           exit(1);
 //       }
 //       receiver_procS(&receiver);
 //       receiver_maketable(&receiver);
 //   }
    // Set length to zero but keep allocation
 //   os[0].reset_write_head();

    //receiver_inputs, store all cs, no more than nOT (1024).
    //4 OTs each group -> cs[4], but Kyber 1 OT each group.
    /*
    for (i = 0; i < nOT; i += 2)
    {
        if (ot_role & RECEIVER)
        {
            for (j = 0; j < 2 and (i + j) < nOT; j++)
            {
                if (new_receiver_inputs)
                    receiver_inputs[i + j] = G.get_uchar()&1;
                cs[j] = receiver_inputs[i + j].get();
                recver.b = cs;
            }

            //os[0] <- Rs_pack[0] <- rsgen (cs)
            receiver_rsgen(&receiver, Rs_pack[0], cs);
            os[0].store_bytes(Rs_pack[0], sizeof(Rs_pack[0]));
            receiver_keygen(&receiver, receiver_keys);

            // Copy keys to receiver_outputs, AES_BLK_SIZE = 16
            for (j = 0; j < 4 and (i + j) < nOT; j++)
            {
                for (k = 0; k < AES_BLK_SIZE; k++)
                {
                    receiver_outputs[i + j].set_byte(k, receiver_keys[j][k]);
                }
            }
        }
    }
    */
   //Kyber 1 OT each group. Replace original variable (OT index in group) j with a char index in packets.
    for (i = 0; i < nOT; i ++)
    {
        if (ot_role & RECEIVER)
        {
            if (new_receiver_inputs)
                receiver_inputs[i] = G.get_uchar()&1;
            cs = receiver_inputs[i].get();
            recver.b = cs;

            //os[0] <- Rs_pack[0] <- pks <- rsgen (cs)
            KyberReceiverMessage(&recver, &pks);
            //os channel only sends unsigned chars instead of char arrays? Copy pks to Rs_pack[0].
            for (j = 0; j < PKlength; j++)
                Rs_pack[0][j] = pks.keys[0][j];
            for (j = 0; j < PKlength; j++)
                Rs_pack[0][j + PKlength] = pks.keys[1][j];
            
            //Pilling up nOT(1024) Rs_packs.
            os[0].store_bytes(Rs_pack[0], sizeof(Rs_pack[0]));

            //receiver_rsgen(&receiver, Rs_pack[0], cs);
            //os[0].store_bytes(Rs_pack[0], sizeof(Rs_pack[0]));
