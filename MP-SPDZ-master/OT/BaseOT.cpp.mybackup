template<class T, class U>
void BaseOT::exec_base(bool new_receiver_inputs)
{
    //vector< array<BitVector, 2> > sender_inputs;
	//vector<BitVector> receiver_outputs;

    int i, j, k;
    size_t len;
    PRNG G;
