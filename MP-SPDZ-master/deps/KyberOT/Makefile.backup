SRCS := kem.c poly.c polyvec.c polyvec_pointwise_acc.s fips202.c reduce.c cbdeta4.s cbdref.c precomp.c verify.c indcpa.c kex.c consts.c genmatrix.c fips202x4.c keccak4x/KeccakP-1600-times4-SIMD256.o ntt.s invntt.s randombytes.c KyberOT.c
OBJS := $(SRCS:.c=.o)

CFLAGS := -mavx2

libKyberOT.a: $(OBJS)
    ar rcs $@ $^

%.o: %.c
    gcc $(CFLAGS) -c $< -o $@

install: libKyberOT.a
    install -d $(CMAKE_INSTALL_PREFIX)/lib
    install -m 644 libKyberOT.a $(CMAKE_INSTALL_PREFIX)/lib/
    install -d $(CMAKE_INSTALL_PREFIX)/include/KyberOT
    install -m 644 *.h $(CMAKE_INSTALL_PREFIX)/include/KyberOT/

clean:
    rm -f $(OBJS) libKyberOT.a
